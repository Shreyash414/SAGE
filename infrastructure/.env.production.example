# ==============================================================================
# SAGE — Production Environment Configuration Template (.env.production.example)
# Copy this file to .env.production on your AWS EC2 instance:
#   cp infrastructure/.env.production.example infrastructure/.env.production
# Do NOT commit your production .env file to public Git repositories.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Reverse Proxy & Domain Configuration (Caddy)
# ------------------------------------------------------------------------------
# Fully Qualified Domain Name pointed to your AWS EC2 Elastic IP
# For testing without a custom domain, set to your EC2 public DNS or 'localhost'
DOMAIN_NAME=sage.example.gov.in

# Valid email address for automated ACME SSL/TLS certificate registration (Let's Encrypt)
ACME_EMAIL=admin@example.gov.in

# ------------------------------------------------------------------------------
# 2. Relational Database Configuration (PostgreSQL 16)
# ------------------------------------------------------------------------------
POSTGRES_DB=sage_db
POSTGRES_USER=sage_user
# Strong database password (mandatory - do NOT use default placeholders in production)
POSTGRES_PASSWORD=your_strong_postgres_password_here

# Connection pool tuning (HikariCP)
HIKARI_MAX_POOL_SIZE=20
HIKARI_MIN_IDLE=5

# ------------------------------------------------------------------------------
# 3. Application Security & Authentication (Spring Boot & FastAPI)
# ------------------------------------------------------------------------------
# Spring profile MUST be set to 'prod'
SPRING_PROFILES_ACTIVE=prod

# Cryptographically strong HMAC-SHA256 secret key for signing user JWTs (Minimum 32 characters)
JWT_SECRET=your_minimum_32_character_cryptographically_secure_jwt_secret_here

# JWT token lifetime in milliseconds (Default: 86400000 = 24 hours)
JWT_EXPIRATION_MS=86400000

# Shared secret token for inter-service authentication (Backend <-> Automation)
# Minimum 32 characters required in production profile (fail-closed security)
INTERNAL_SERVICE_TOKEN=your_minimum_32_character_internal_service_secret_token_here

# ------------------------------------------------------------------------------
# 4. Google Gemini Document Intelligence
# ------------------------------------------------------------------------------
# Gemini API Key used for format checks and forgery risk evaluation
GEMINI_API_KEY=your_gemini_api_key_here

# Gemini Model identifier (Default: gemini-flash-lite-latest)
GEMINI_MODEL=gemini-flash-lite-latest

# ------------------------------------------------------------------------------
# 5. Automation & OCR Engine Configuration (FastAPI)
# ------------------------------------------------------------------------------
ENVIRONMENT=prod
AUTOMATION_PORT=8000
AUTOMATION_HOST=0.0.0.0

# Allowed CORS origins for browser/API clients (comma-separated URLs)
CORS_ORIGINS=https://sage.example.gov.in
