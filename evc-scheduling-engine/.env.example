# ==============================================================================
# AICTE EVC Scheduling Engine — Local Environment Configuration Template (.env.example)
#
# INSTRUCTIONS:
# 1. Copy this file to .env for local deployment:
#    cp .env.example .env
# 2. DO NOT commit .env or any file containing real credentials to version control.
# ==============================================================================

# Server Network Configuration (Defaults to 8081; SAGE backend runs on 8080)
SERVER_PORT=8081

# Shared PostgreSQL Server Configuration (SAGE PostgreSQL runs on port 5432)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=aicte_platform_db
DB_USER=aicte_app_user
DB_PASSWORD=your_secure_db_password_here

# JDBC Connection URL Targeting Dedicated 'evc' Schema Namespace
# Guarantees full schema isolation from SAGE tables in 'public'
SPRING_DATASOURCE_URL=jdbc:postgresql://${DB_HOST}:${DB_PORT}/${DB_NAME}?currentSchema=evc
SPRING_DATASOURCE_USERNAME=${DB_USER}
SPRING_DATASOURCE_PASSWORD=${DB_PASSWORD}

# Service-to-Service Authentication Key
# Shared secret for SAGE backend client calls (passed via X-API-KEY or Authorization: Bearer <key>)
EVC_API_KEY=your_secure_evc_api_key_here

