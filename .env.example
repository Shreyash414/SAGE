# ==============================================================================
# AICTE Approval & Compliance Orchestration Platform
# Local Environment Configuration Template (.env.example)
#
# INSTRUCTIONS:
# 1. Copy this file to .env for local development:
#    cp .env.example .env
# 2. DO NOT commit .env or any file containing real credentials to version control.
# ==============================================================================

# Server Configuration
SERVER_PORT=8080
SERVER_SERVLET_CONTEXT_PATH=/api/v1

# PostgreSQL Database Configuration
DB_HOST=localhost
DB_PORT=5432
DB_NAME=aicte_platform_db
DB_USER=aicte_app_user
DB_PASSWORD=your_secure_db_password_here

# Flyway Migration Settings
FLYWAY_ENABLED=true
FLYWAY_BASELINE_ON_MIGRATE=true

# Security / Token Settings (Use dummy/generated keys for local dev)
JWT_SECRET=change_me_to_a_secure_256_bit_random_secret_string_minimum_32_chars
JWT_EXPIRATION_SECONDS=86400

# File Storage Configuration (Local directory for prototype development)
STORAGE_TYPE=local
STORAGE_LOCAL_ROOT_PATH=./uploads

# Logging Configuration
LOGGING_LEVEL_ROOT=INFO
LOGGING_LEVEL_AICTE=DEBUG
